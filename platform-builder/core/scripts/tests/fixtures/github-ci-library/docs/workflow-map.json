{
  "$comment": "Test fixture shaped like the library's data file; the skill reads the real one from the library at the release a project pins.",
  "schema": 1,
  "scenarios": {
    "pr.yml": {
      "purpose": "Full pre-merge verification."
    },
    "release.yml": {
      "purpose": "Tag, promote candidate by digest, publish release, notify."
    },
    "build.yml": {
      "purpose": "Build and unit test only."
    },
    "check.yml": {
      "purpose": "Release prerequisite guards only."
    },
    "lint.yml": {
      "purpose": "Multi-linter suite."
    },
    "deploy.yml": {
      "purpose": "Targeted GitOps deployment without building."
    },
    "image-scan.yml": {
      "purpose": "Scan an existing remote image tag."
    },
    "chart-scan.yml": {
      "purpose": "Render and scan a local or remote chart."
    },
    "license-scan.yml": {
      "purpose": "Dependency licence compliance audit."
    },
    "sbom.yml": {
      "purpose": "CycloneDX SBOM generation and CVE scan."
    },
    "secret-scan.yml": {
      "purpose": "Betterleaks git-history audit."
    },
    "sonarqube.yml": {
      "purpose": "Analysis and quality gate."
    }
  },
  "shapes": {
    "image-only": {
